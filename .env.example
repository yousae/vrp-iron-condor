# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file -- it's already in .gitignore.
#
# PAPER KEYS ONLY. Generate these from the Alpaca dashboard with the
# paper-trading environment selected. src/execution/alpaca_client.py
# hard-blocks live trading (get_client(paper=False) raises), but do not
# rely on that alone -- putting live keys here would be a mistake, since
# live trading is out of scope for this project entirely (spec s12).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Market data (VIX / SPX / ^IRX) comes from Yahoo Finance via yfinance,
# which is unauthenticated -- no key needed. Alpaca does not currently
# provide index option market data, which is why strikes are computed
# from the model rather than read off a live chain.
#
# If a paid historical options-chain provider is adopted later
# (project_spec.md section 6, step 2), its key belongs here.
# CHAIN_PROVIDER_API_KEY=
